; Block structure. Bold, code spans and links are in markdownInline.scm.

(atx_heading (inline) @keyword)
(setext_heading (paragraph) @keyword)

[
  (atx_h1_marker)
  (atx_h2_marker)
  (atx_h3_marker)
  (atx_h4_marker)
  (atx_h5_marker)
  (atx_h6_marker)
  (setext_h1_underline)
  (setext_h2_underline)
  (list_marker_plus)
  (list_marker_minus)
  (list_marker_star)
  (list_marker_dot)
  (list_marker_parenthesis)
  (link_label)
] @keyword

[
  (fenced_code_block)
  (indented_code_block)
  (link_title)
] @string

[
  (fenced_code_block_delimiter)
  (info_string)
  (thematic_break)
  (block_quote_marker)
  (block_continuation)
  (link_destination)
] @comment

(backslash_escape) @escape
